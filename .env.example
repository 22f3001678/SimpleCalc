# Example environment variables for SimpleCalc

# Backend
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info

# Frontend (Vite)
VITE_BASE=./
VITE_API_BASE_URL=http://localhost:3001/api

# Docker / Deployment
# Set CORS_ORIGIN to your production frontend origin when deploying

